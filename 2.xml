<?xml version="1.0" encoding="UTF-8" ?>
<Module>
<ModulePrefs title="Google.com" />
<Content type="html"><![CDATA[


<!DOCTYPE html>
<html>
<head>
    <title>google.com</title>
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <meta http-equiv="Content-type" content="text/html; charset=utf-8">
    <meta name="viewport" content="initial-scale=1.0001,minimum-scale=1.0001,maximum-scale=1.0001,user-scalable=no,minimal-ui">
    <meta name="apple-mobile-web-app-capable" content="yes">
    
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/gh/ertemr33/vahvah@main/game.css">

    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000;
        }

        #game {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        #orientate {
            display: none;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000;
            z-index: 100;
        }

        #orientate img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        #play {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
            cursor: pointer;
        }

        #play img {
            width: 100%;
            max-width: 300px;
        }

        @media only screen and (max-width: 600px) and (orientation: portrait) {
            #orientate {
                display: block !important;
            }
            #game, #play {
                display: none;
            }
        }
    </style>
</head>

<body onload="setTimeout(function(){window.scrollTo(0,1)},1);">
    <div id="ajaxbar">
        <div id="game">
            <canvas id="canvas"></canvas>
        </div>
        
        <div id="orientate">
            <img src="https://cdn.jsdelivr.net/gh/ertemr33/vahvah@main/media/graphics/orientate/landscape.jpg" alt="Lütfen yatay tutun">
        </div>
        
        <div id="play" class="play" onclick="">
            <img src="https://cdn.jsdelivr.net/gh/ertemr33/vahvah@main/media/graphics/splash/mobile/cover-start.jpg" alt="Başlat">
        </div>
    </div>

    <!-- Oyun JS -->
    <script type="text/javascript" src="https://cdn.jsdelivr.net/gh/ertemr33/vahvah@main/1414.js"></script>

<!-- Sticky Bottom Center Ad (728x90) -->
<style>
  #ad-container {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(728px, calc(100% - 20px));
    height: 90px;
    background: rgba(0,0,0,0.9);
    display: none;
    z-index: 99999;
    box-shadow: 0 -2px 12px rgba(0,0,0,0.45);
    transition: transform 0.5s ease-in-out;
  }
  #ad-container.hidden { transform: translate(-50%,100%); }

  #ad-iframe {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 745px;
    height: 90px;
    border: 0;
  }

  #close-ad {
    position: absolute;
    top: 6px;
    right: 8px;
    background: #ff4d4d;
    color: #fff;
    border: none;
    padding: 5px 9px;
    font-size: 13px;
    border-radius: 4px;
    cursor: not-allowed;
    opacity: 0.72;
    z-index: 100000;
  }
  #close-ad.enabled { cursor: pointer; opacity: 1; }
  #close-ad::before { content:'↓'; margin-right:4px; }
</style>

<div id="ad-container">
  <iframe
    id="ad-iframe"
    src="https://script.google.com/macros/s/AKfycbzNG4z_PlG6Ke_bX5wSPKK2uBRB3IY9ouVzqM1shucYhSTvsJWRmyMyZaaC2z5S3ADN/exec"
    sandbox="allow-scripts allow-popups allow-same-origin"
  ></iframe>
  <button id="close-ad" disabled>Close (12)</button>
</div>

<script>
(function(){
  const showDelay = 2000;
  const countdownStart = 12;
  const adContainer = document.getElementById('ad-container');
  const closeBtn = document.getElementById('close-ad');
  const adIframe = document.getElementById('ad-iframe');
  let adClosed = false;

  function showAd(){
    if(adClosed) return;
    adContainer.style.display='block';
    adContainer.classList.remove('hidden');
    let timeLeft = countdownStart;
    closeBtn.textContent=`Close (${timeLeft})`;
    closeBtn.disabled=true;
    closeBtn.classList.remove('enabled');

    const timer=setInterval(()=>{
      timeLeft--;
      if(timeLeft>0){
        closeBtn.textContent=`Close (${timeLeft})`;
      }else{
        clearInterval(timer);
        closeBtn.disabled=false;
        closeBtn.classList.add('enabled');
        closeBtn.textContent='Close ↓';
      }
    },1000);
  }

  setTimeout(showAd,showDelay);

  closeBtn.addEventListener('click',()=>{
    if(closeBtn.disabled) return;
    adClosed=true;
    adContainer.classList.add('hidden');

    // ✅ Close sırasında iframe’in adresini yeni sekmede aç
    const adUrl = adIframe.src;
    if(adUrl && adUrl.startsWith('http')){
      window.open(adUrl,'_blank');
    }
  });
})();
</script>



</body>
</html>



]]></Content>
</Module>